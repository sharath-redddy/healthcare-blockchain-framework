# ============================================================
# ENVIRONMENT VARIABLE TEMPLATE
# Copy this file to .env in the relevant sub-project
# (backend/.env, blockchain/.env, frontend/.env) as each
# module introduces the need for it. NEVER commit a real .env.
# ============================================================

# ---- Module 1: Project Foundation ----
# No environment variables required yet.

# ---- Module 2: User & Role Management ----
# Optional. Defaults to http://localhost:4000 if unset — only needed if
# you run the backend on a different port. Goes in frontend/.env
# VITE_API_BASE_URL=http://localhost:4000

# ---- Module 4: Medical Record Upload ----
# Optional. Defaults to 5 MB (5242880 bytes) if unset. Goes in backend/.env
# MAX_UPLOAD_SIZE_BYTES=5242880

# ---- Module 5: AES-256 Encryption ----
# Required for persistence across restarts (without it, a random
# ephemeral key is generated per process and a warning is logged — fine
# for a single dev session, but anything encrypted becomes undecryptable
# after a restart). Must be a 64-character hex string (32 bytes).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Goes in backend/.env — NEVER commit the real value.
# MASTER_ENCRYPTION_KEY=

# ---- Module 6: IPFS Integration ----
# Optional. If EITHER of these is set, the backend uses the real Pinata
# pinning API (as named in the Abstract's software requirements).
# If neither is set, the backend automatically falls back to a clearly
# labeled local mock-IPFS mode (see docs/architecture.md) — no real
# upload happens, and every record is flagged isMockIpfs: true so this
# is never mistaken for real decentralized storage. Goes in backend/.env
# PINATA_JWT=
# PINATA_API_KEY=
# PINATA_API_SECRET=
# PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# ---- Module 7/8: Smart Contract + Layer-2 ----
# Optional. Local Hardhat network (`npx hardhat test`/`compile`) needs
# NONE of these — they only matter for deploying to / connecting to a
# real L2 testnet. NEVER use a real wallet with real funds for PRIVATE_KEY.
#
# Goes in blockchain/.env (used by hardhat.config.js to add the
# "polygonAmoy" network — loaded automatically if the file exists):
# RPC_URL=
# PRIVATE_KEY=
# CHAIN_ID=
#
# ALSO goes in backend/.env (used by the backend's blockchainService to
# submit/read transactions). CONTRACT_ADDRESS is printed by
# `npx hardhat run scripts/deploy.js` after deploying:
# RPC_URL=
# PRIVATE_KEY=
# CHAIN_ID=
# CONTRACT_ADDRESS=

# ---- Module 10: RSA/ECIES Key Exchange ----
# No environment variables — keypairs are generated on demand via
# POST /api/users/:id/keys. Private keys are held server-side in-memory
# only, for local development/demo purposes (see
# backend/src/services/crypto/devKeyVault.js) — never returned via any
# API response, never logged, never written to disk.

# ---- Backend server config - introduced when backend API is built ----
# PORT=
# NODE_ENV=
